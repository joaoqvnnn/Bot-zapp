# ============================================
# LARIZINHA STORE — VARIÁVEIS DE AMBIENTE
# Copie para .env e preencha com seus valores
# ============================================

# --------------------------------------------
# 🔧 AMBIENTE / APLICAÇÃO
# --------------------------------------------
ENV=production
DEBUG=false
APP_NAME=Larizinha Store
APP_VERSION=1.0.0
TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR
DEFAULT_CURRENCY=BRL

# --------------------------------------------
# 🤖 TELEGRAM BOT
# --------------------------------------------
BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_USERNAME=SeuBotUsername
BOT_ID=0000000000
ADMIN_IDS=123456789,987654321
MAIN_ADMIN_ID=123456789

# Canal / Grupo obrigatórios (chat_id numérico, começa com -100)
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_CHANNEL_USERNAME=seucanal
REQUIRED_GROUP_ID=-1001234567890
REQUIRED_GROUP_USERNAME=seugrupo

# Link silencioso de atendimento (formato: https://t.me/m/xxxxx)
SUPPORT_SILENT_LINK=https://t.me/m/xxxxxxxxxxxxx

# --------------------------------------------
# 🗄️ POSTGRESQL (Render)
# --------------------------------------------
DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/larizinha
DATABASE_URL_SYNC=postgresql://usuario:senha@host:5432/larizinha
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --------------------------------------------
# ⚡ REDIS (travas, cache, filas)
# --------------------------------------------
REDIS_URL=redis://default:senha@host:6379/0
REDIS_PREFIX=larizinha
REDIS_LOCK_TTL=300
REDIS_VIEW_TTL=120
REDIS_HEARTBEAT_TTL=60

# --------------------------------------------
# 💳 MERCADO PAGO (PIX)
# --------------------------------------------
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_CLIENT_ID=0000000000000000
MP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_URL=https://seu-app.onrender.com/webhook/mercadopago
MP_PIX_EXPIRATION_MINUTES=30
MP_PIX_STATEMENT_DESCRIPTOR=LARIZINHASTORE

# --------------------------------------------
# 📧 SMTP (recuperação de senha de saque)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_EMAIL=seuemail@gmail.com
SMTP_PASSWORD=suasenhaDeApp
SMTP_FROM_NAME=Larizinha Store
SMTP_FROM_EMAIL=seuemail@gmail.com

# --------------------------------------------
# 🌐 WEBHOOK / API INTERNA
# --------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=uma-string-secreta-longa-e-aleatoria
API_BASE_URL=https://seu-app.onrender.com
TELEGRAM_WEBHOOK_URL=https://seu-app.onrender.com/webhook/telegram

# --------------------------------------------
# 🖥️ WEBAPP (Loja + Senha de Saque)
# --------------------------------------------
WEBAPP_URL=https://seu-webapp.onrender.com
WEBAPP_SECRET=uma-string-secreta-para-assinar-webapp
WEBAPP_AUTH_MAX_AGE=86400

# --------------------------------------------
# 💰 REGRAS FINANCEIRAS
# --------------------------------------------
MIN_DEPOSIT=10.00
MAX_DEPOSIT=5000.00
MIN_WITHDRAW=20.00
MAX_WITHDRAW=5000.00
WITHDRAW_FEE_PERCENT=0
WITHDRAW_DAILY_LIMIT=3
WITHDRAW_AUTO_APPROVE=false
WITHDRAW_PROCESSING_DAYS=1
DEPOSIT_BONUS_PERCENT=0
DEPOSIT_BONUS_MIN=50.00
INITIAL_BALANCE=0.00

# --------------------------------------------
# 🎁 AFILIADOS
# --------------------------------------------
AFFILIATE_COMMISSION_PERCENT=10
AFFILIATE_COMMISSION_DEPOSIT_PERCENT=5
AFFILIATE_MIN_WITHDRAW=20.00
AFFILIATE_ENABLED=true

# --------------------------------------------
# ⏱️ AUTOMAÇÕES (delays em minutos)
# --------------------------------------------
AUTO_PIX_EXPIRED=true
AUTO_PIX_EXPIRED_DELAY=30

AUTO_PIX_UNPAID=true
AUTO_PIX_UNPAID_DELAY=60

AUTO_CART_ABANDONED=true
AUTO_CART_ABANDONED_DELAY=15

AUTO_NEW_PROMO=true
AUTO_NEW_PROMO_DELAY=5

AUTO_LOW_STOCK=true
AUTO_LOW_STOCK_THRESHOLD=5

AUTO_HEARTBEAT=true
AUTO_HEARTBEAT_TIMEOUT=120

# --------------------------------------------
# 🔒 TRAVAS / CONCORRÊNCIA
# --------------------------------------------
ENABLE_CONCURRENCY_LOCK=true
PRODUCT_LOCK_TTL=300
USER_VIEW_TTL=120

# --------------------------------------------
# 🛡️ SEGURANÇA / ANTIFRAUDE
# --------------------------------------------
ANTIFRAUD_ENABLED=true
ANTIFRAUD_MAX_ACCOUNTS_PER_IP=3
ANTIFRAUD_SUSPICIOUS_AMOUNT=1000.00
THROTTLE_RATE=0.5
TEMP_BLOCK_MINUTES=15

# --------------------------------------------
# 📊 LOGS / MONITORAMENTO
# --------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/bot.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
SENTRY_DSN=

# --------------------------------------------
# 💾 BACKUP
# --------------------------------------------
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups

# --------------------------------------------
# 🚀 RENDER
# --------------------------------------------
RENDER=true
RENDER_EXTERNAL_URL=https://seu-app.onrender.com
PORT=8000
